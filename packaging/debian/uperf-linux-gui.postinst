#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
    echo "uperf-linux was not enabled or started by this package operation."
    echo "Review /etc/uperf-linux and validate the complete live configuration"
    echo "as described in /usr/share/doc/uperf-linux-gui/README.Debian before enabling it."
fi

#DEBHELPER#
