<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
  "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>uperf-linux-rev</vendor>
  <vendor_url>https://github.com/EmberLuo/uperf-linux-rev</vendor_url>

  <action id="org.uperflinux.control">
    <description>Change the active uperf-linux performance profile</description>
    <message>Authentication is required to change the system performance profile</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <action id="org.uperflinux.admin">
    <description>Change privileged uperf-linux settings</description>
    <message>Administrator authentication is required to change hardware settings</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
</policyconfig>

