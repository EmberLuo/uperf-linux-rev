{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeviceConfig",
  "type": "object",
  "properties": {
    "cpu_groups": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/CpuSet"
      },
      "default": {}
    },
    "cpu_policies": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/CpuPolicyConfig"
      },
      "maxItems": 256
    },
    "devfreq_targets": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/DevfreqTargetConfig"
      },
      "maxItems": 256
    },
    "device_id": {
      "type": "string"
    },
    "device_match": {
      "anyOf": [
        {
          "$ref": "#/$defs/DeviceMatch"
        },
        {
          "type": "null"
        }
      ]
    },
    "scalar_targets": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/ScalarTargetConfig"
      },
      "maxItems": 256
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "thermal_zones": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/ThermalZoneConfig"
      },
      "maxItems": 256
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "device_id"
  ],
  "$defs": {
    "CpuEnergyModelConfig": {
      "description": "Calibrated energy data for one Linux CPU frequency policy.\n\nModels are deliberately attached to a stable `related_cpus` selector rather\nthan to a kernel `policyN` directory.  `ReferenceCurveV1` preserves the\ndocumented Uperf v3 curve semantics; `MeasuredOppV1` is the preferred\nrepresentation once a device has been measured on Linux.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "free_frequency_hz": {
              "$ref": "#/$defs/Hertz"
            },
            "kind": {
              "type": "string",
              "const": "reference-curve-v1"
            },
            "plain_frequency_hz": {
              "$ref": "#/$defs/Hertz"
            },
            "relative_performance": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "sweet_frequency_hz": {
              "$ref": "#/$defs/Hertz"
            },
            "typical_frequency_hz": {
              "$ref": "#/$defs/Hertz"
            },
            "typical_power_mw_per_core": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "relative_performance",
            "typical_power_mw_per_core",
            "typical_frequency_hz",
            "sweet_frequency_hz",
            "plain_frequency_hz",
            "free_frequency_hz"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "measured-opp-v1"
            },
            "points": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/MeasuredOppConfig"
              },
              "maxItems": 256,
              "minItems": 2
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "points"
          ]
        }
      ]
    },
    "CpuPolicyConfig": {
      "type": "object",
      "properties": {
        "admin_cap_hz": {
          "anyOf": [
            {
              "$ref": "#/$defs/Hertz"
            },
            {
              "type": "null"
            }
          ]
        },
        "critical_cap_hz": {
          "anyOf": [
            {
              "$ref": "#/$defs/Hertz"
            },
            {
              "type": "null"
            }
          ]
        },
        "efficient_cap_hz": {
          "$ref": "#/$defs/Hertz"
        },
        "energy_model": {
          "description": "Optional calibrated model.  Absence keeps the legacy governor active.",
          "anyOf": [
            {
              "$ref": "#/$defs/CpuEnergyModelConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "floor_hz": {
          "$ref": "#/$defs/Hertz"
        },
        "id": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "reference_hz": {
          "$ref": "#/$defs/Hertz"
        },
        "related_cpus": {
          "description": "Stable selector.  The Linux adapter resolves it against each policy's\ncurrent `related_cpus`; policy directory numbering is not persisted.",
          "$ref": "#/$defs/CpuSet"
        },
        "sensor_failure_cap_hz": {
          "anyOf": [
            {
              "$ref": "#/$defs/Hertz"
            },
            {
              "type": "null"
            }
          ]
        },
        "sysfs_path": {
          "description": "Optional administrator override for unusual kernels.  Normal profiles\nleave this unset and rely on `related_cpus`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "related_cpus",
        "floor_hz",
        "reference_hz",
        "efficient_cap_hz"
      ]
    },
    "CpuSet": {
      "description": "A dynamically sized set of logical CPU IDs.",
      "type": "array",
      "items": {
        "type": "integer",
        "format": "uint32",
        "minimum": 0
      },
      "uniqueItems": true
    },
    "DevfreqTargetConfig": {
      "type": "object",
      "properties": {
        "admin_cap_hz": {
          "anyOf": [
            {
              "$ref": "#/$defs/Hertz"
            },
            {
              "type": "null"
            }
          ]
        },
        "compatible": {
          "description": "Optional device-tree compatible strings used to disambiguate similarly\nnamed devfreq devices.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 64
        },
        "critical_cap_hz": {
          "anyOf": [
            {
              "$ref": "#/$defs/Hertz"
            },
            {
              "type": "null"
            }
          ]
        },
        "device_name": {
          "description": "Stable devfreq directory/device name used during discovery.",
          "type": "string"
        },
        "id": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "manual_only": {
          "type": "boolean",
          "default": true
        },
        "sensor_failure_cap_hz": {
          "anyOf": [
            {
              "$ref": "#/$defs/Hertz"
            },
            {
              "type": "null"
            }
          ]
        },
        "sysfs_path": {
          "description": "Optional administrator override for devices without a stable name.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "device_name"
      ]
    },
    "DeviceMatch": {
      "type": "object",
      "properties": {
        "compatible": {
          "type": [
            "string",
            "null"
          ]
        },
        "product_name": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "Hertz": {
      "description": "Frequency in hertz.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "MeasuredOppConfig": {
      "type": "object",
      "properties": {
        "frequency_hz": {
          "$ref": "#/$defs/Hertz"
        },
        "power_mw_per_core": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "relative_capacity": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "frequency_hz",
        "relative_capacity",
        "power_mw_per_core"
      ]
    },
    "MilliCelsius": {
      "description": "Temperature in thousandths of one degree Celsius.",
      "type": "integer",
      "format": "int64"
    },
    "ScalarTargetConfig": {
      "type": "object",
      "properties": {
        "domain": {
          "$ref": "#/$defs/ScalarTargetDomainConfig"
        },
        "id": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "path": {
          "description": "Absolute logical sysfs path from a root-owned device profile.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "domain"
      ]
    },
    "ScalarTargetDomainConfig": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "integer-range"
            },
            "maximum": {
              "type": "integer",
              "format": "int64"
            },
            "minimum": {
              "type": "integer",
              "format": "int64"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "minimum",
            "maximum"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "integer-enum"
            },
            "values": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "int64"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "values"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "string-enum"
            },
            "values": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "values"
          ]
        },
        {
          "type": "object",
          "properties": {
            "allow_empty": {
              "type": "boolean",
              "default": false
            },
            "allowed_cpus": {
              "$ref": "#/$defs/CpuSet"
            },
            "kind": {
              "type": "string",
              "const": "cpu-list"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "allowed_cpus"
          ]
        }
      ]
    },
    "ThermalZoneConfig": {
      "type": "object",
      "properties": {
        "critical": {
          "$ref": "#/$defs/MilliCelsius"
        },
        "dwell_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "hysteresis": {
          "$ref": "#/$defs/MilliCelsius"
        },
        "id": {
          "type": "string"
        },
        "stale_after_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "sysfs_path": {
          "description": "Optional explicit override.  Normal profiles select by `zone_type`\nbecause `thermal_zoneN` numbering is not stable across boots.",
          "type": [
            "string",
            "null"
          ]
        },
        "throttled": {
          "$ref": "#/$defs/MilliCelsius"
        },
        "warning": {
          "$ref": "#/$defs/MilliCelsius"
        },
        "zone_type": {
          "description": "Stable value of the thermal zone's `type` file.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "zone_type",
        "warning",
        "throttled",
        "critical",
        "hysteresis",
        "dwell_ms",
        "stale_after_ms"
      ]
    }
  }
}
