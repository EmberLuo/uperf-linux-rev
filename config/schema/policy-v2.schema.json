{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PolicyConfig",
  "type": "object",
  "properties": {
    "default_profile": {
      "$ref": "#/$defs/ProfileId"
    },
    "governor": {
      "$ref": "#/$defs/GovernorConfig",
      "default": {
        "active_load_threshold": 0.3,
        "active_sample_ms": 20,
        "ema_time_constant_ms": 40,
        "idle_load_threshold": 0.15,
        "idle_sample_ms": 80,
        "min_opp_residency_ms": 10,
        "predict_threshold": 0.15,
        "prediction_gain": 1.0,
        "ramp_latency_ms": 100,
        "rollout": "legacy"
      }
    },
    "input": {
      "$ref": "#/$defs/InputConfig",
      "default": {
        "edge_width": 0.03,
        "enabled": true,
        "gesture_duration_ms": 100,
        "swipe_distance": 0.03,
        "switch_duration_ms": 400,
        "trigger_duration_ms": 30,
        "wake_duration_ms": 500
      }
    },
    "load": {
      "$ref": "#/$defs/LoadConfig",
      "default": {
        "ema_time_constant_ms": 500,
        "enabled": true,
        "heavy_dwell_ms": 1000,
        "heavy_enter": 0.6,
        "heavy_exit": 0.2,
        "sample_interval_ms": 250
      }
    },
    "profiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProfileConfig"
      },
      "maxItems": 8
    },
    "scheduler": {
      "$ref": "#/$defs/SchedulerConfig",
      "default": {
        "cgroup_classes": [],
        "enabled": false,
        "focus": {
          "debounce_ms": 150,
          "enabled": false,
          "lease_ttl_ms": 15000,
          "protected": []
        },
        "process_rules": [],
        "realtime": {
          "enabled": false,
          "housekeeping_cpus": [],
          "max_priority": 20
        },
        "task_profiles": []
      }
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "session": {
      "anyOf": [
        {
          "$ref": "#/$defs/SessionProfileConfig"
        },
        {
          "type": "null"
        }
      ]
    },
    "thermal": {
      "$ref": "#/$defs/ThermalPolicyConfig",
      "default": {
        "sample_interval_ms": 250
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "default_profile",
    "profiles"
  ],
  "$defs": {
    "CgroupClassConfig": {
      "type": "object",
      "properties": {
        "allowed_cpu_group": {
          "type": [
            "string",
            "null"
          ]
        },
        "allowed_cpus": {
          "$ref": "#/$defs/CpuSet",
          "default": []
        },
        "cpu_weight": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "cpu_weight"
      ]
    },
    "CpuSet": {
      "description": "A dynamically sized set of logical CPU IDs.",
      "type": "array",
      "items": {
        "type": "integer",
        "format": "uint32",
        "minimum": 0
      },
      "uniqueItems": true
    },
    "FocusConfig": {
      "description": "Focus-driven workload selection.\n\nA trusted desktop adapter reports which process owns the focused window; the\ndaemon treats that report as a *workload source*, never as a profile tier.\nWhen no process rule matches the focused workload, [`Self::task_profile`]\nsupplies a gentle default plan so the feature is useful without requiring\noperators to author per-application rules first.",
      "type": "object",
      "properties": {
        "debounce_ms": {
          "description": "Coalescing window for rapid window switching.",
          "type": "integer",
          "format": "uint64",
          "default": 150,
          "minimum": 0
        },
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "lease_ttl_ms": {
          "description": "Lease lifetime; a reporter that stops renewing loses the boost.",
          "type": "integer",
          "format": "uint64",
          "default": 15000,
          "maximum": 600000,
          "minimum": 15000
        },
        "protected": {
          "description": "Processes that may never be leased as a focused workload.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/WorkloadMatcher"
          },
          "maxItems": 256
        },
        "task_profile": {
          "description": "Task profile applied to a focused workload that matches no process rule.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "GovernorConfig": {
      "type": "object",
      "properties": {
        "active_load_threshold": {
          "type": "number",
          "format": "double"
        },
        "active_sample_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "ema_time_constant_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "idle_load_threshold": {
          "type": "number",
          "format": "double"
        },
        "idle_sample_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "min_opp_residency_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "predict_threshold": {
          "type": "number",
          "format": "double"
        },
        "prediction_gain": {
          "type": "number",
          "format": "double"
        },
        "ramp_latency_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "rollout": {
          "$ref": "#/$defs/GovernorRollout",
          "default": "legacy"
        }
      },
      "additionalProperties": false,
      "required": [
        "active_sample_ms",
        "idle_sample_ms",
        "active_load_threshold",
        "idle_load_threshold",
        "ema_time_constant_ms",
        "predict_threshold",
        "prediction_gain",
        "ramp_latency_ms",
        "min_opp_residency_ms"
      ]
    },
    "GovernorRollout": {
      "type": "string",
      "enum": [
        "legacy",
        "shadow",
        "energy"
      ]
    },
    "InputConfig": {
      "type": "object",
      "properties": {
        "edge_width": {
          "description": "Normalized distance from a display edge in `[0, 0.5]`.",
          "type": "number",
          "format": "double"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "gesture_duration_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "swipe_distance": {
          "description": "Normalized movement threshold in `[0, 1]`.",
          "type": "number",
          "format": "double"
        },
        "switch_duration_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "trigger_duration_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "wake_duration_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "trigger_duration_ms",
        "gesture_duration_ms",
        "switch_duration_ms",
        "wake_duration_ms",
        "swipe_distance",
        "edge_width"
      ]
    },
    "LoadConfig": {
      "type": "object",
      "properties": {
        "ema_time_constant_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "heavy_dwell_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "heavy_enter": {
          "type": "number",
          "format": "double"
        },
        "heavy_exit": {
          "type": "number",
          "format": "double"
        },
        "sample_interval_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "sample_interval_ms",
        "ema_time_constant_ms",
        "heavy_enter",
        "heavy_exit",
        "heavy_dwell_ms"
      ]
    },
    "PowerBudgetConfig": {
      "type": "object",
      "properties": {
        "fast_limit_capacity_mj": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "fast_limit_power_mw": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "fast_limit_recover_scale": {
          "type": "number",
          "format": "double"
        },
        "slow_limit_power_mw": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "slow_limit_power_mw",
        "fast_limit_power_mw",
        "fast_limit_capacity_mj",
        "fast_limit_recover_scale"
      ]
    },
    "PowerBudgetPatch": {
      "type": "object",
      "properties": {
        "fast_limit_capacity_mj": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "fast_limit_power_mw": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "fast_limit_recover_scale": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "slow_limit_power_mw": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "ProcessRuleConfig": {
      "type": "object",
      "properties": {
        "cgroup_class": {
          "type": [
            "string",
            "null"
          ]
        },
        "matcher": {
          "$ref": "#/$defs/WorkloadMatcher"
        },
        "name": {
          "type": "string"
        },
        "task_profile": {
          "type": [
            "string",
            "null"
          ]
        },
        "threads": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/ThreadRuleConfig"
          },
          "maxItems": 256
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "matcher"
      ]
    },
    "ProfileConfig": {
      "type": "object",
      "properties": {
        "burst": {
          "type": "number",
          "format": "double"
        },
        "id": {
          "$ref": "#/$defs/ProfileId"
        },
        "limit_efficiency": {
          "type": "boolean"
        },
        "margin": {
          "type": "number",
          "format": "double"
        },
        "power_budget": {
          "anyOf": [
            {
              "$ref": "#/$defs/PowerBudgetConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "scalar_values": {
          "type": "object",
          "additionalProperties": false,
          "default": {},
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$": {
              "$ref": "#/$defs/ScalarSettingValue"
            }
          }
        },
        "scenes": {
          "type": "object",
          "properties": {
            "boost": {
              "$ref": "#/$defs/ScenePatch"
            },
            "gesture": {
              "$ref": "#/$defs/ScenePatch"
            },
            "idle": {
              "$ref": "#/$defs/ScenePatch"
            },
            "junk": {
              "$ref": "#/$defs/ScenePatch"
            },
            "switch": {
              "$ref": "#/$defs/ScenePatch"
            },
            "touch": {
              "$ref": "#/$defs/ScenePatch"
            },
            "trigger": {
              "$ref": "#/$defs/ScenePatch"
            },
            "wake": {
              "$ref": "#/$defs/ScenePatch"
            }
          },
          "additionalProperties": false,
          "default": {}
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "margin",
        "burst",
        "limit_efficiency"
      ]
    },
    "ProfileId": {
      "type": "string",
      "enum": [
        "powersave",
        "balance",
        "performance"
      ]
    },
    "RealtimeSchedulerConfig": {
      "description": "Explicit opt-in envelope for experimental `SCHED_FIFO` task plans.",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "housekeeping_cpus": {
          "description": "CPUs reserved for the daemon, watchdogs, and other housekeeping work.",
          "$ref": "#/$defs/CpuSet",
          "default": []
        },
        "max_priority": {
          "type": "integer",
          "format": "uint8",
          "default": 20,
          "maximum": 50,
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "ScalarSettingValue": {
      "description": "Typed value for one root-reviewed scalar sysfs resource.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "integer"
            },
            "value": {
              "type": "integer",
              "format": "int64"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "cpu-list"
            },
            "value": {
              "$ref": "#/$defs/CpuSet"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        }
      ]
    },
    "ScenePatch": {
      "type": "object",
      "properties": {
        "burst": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "limit_efficiency": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "margin": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "power_budget": {
          "anyOf": [
            {
              "$ref": "#/$defs/PowerBudgetPatch"
            },
            {
              "type": "null"
            }
          ]
        },
        "scalar_values": {
          "type": "object",
          "additionalProperties": false,
          "default": {},
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$": {
              "$ref": "#/$defs/ScalarSettingValue"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "SchedulerConfig": {
      "type": "object",
      "properties": {
        "cgroup_classes": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/CgroupClassConfig"
          },
          "maxItems": 256
        },
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "focus": {
          "$ref": "#/$defs/FocusConfig",
          "default": {
            "debounce_ms": 150,
            "enabled": false,
            "lease_ttl_ms": 15000,
            "protected": []
          }
        },
        "process_rules": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/ProcessRuleConfig"
          },
          "maxItems": 1024
        },
        "realtime": {
          "$ref": "#/$defs/RealtimeSchedulerConfig",
          "default": {
            "enabled": false,
            "housekeeping_cpus": [],
            "max_priority": 20
          }
        },
        "task_profiles": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/TaskProfileConfig"
          },
          "maxItems": 256
        }
      },
      "additionalProperties": false
    },
    "SchedulingClass": {
      "type": "string",
      "enum": [
        "other",
        "batch",
        "idle",
        "fifo"
      ]
    },
    "SessionProfileConfig": {
      "description": "Optional profile overrides driven by trusted desktop session state.\n\nThese are policy references only.  Platform observers decide whether a\nsession is locked or its display is blanked; neither state is inferred from\nthe other.",
      "type": "object",
      "properties": {
        "display_blanked_profile": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProfileId"
            },
            {
              "type": "null"
            }
          ]
        },
        "locked_profile": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProfileId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "TaskPlan": {
      "description": "Partial scheduling intent for one process or thread.\n\nEvery absent field preserves the task's current value. In particular,\n`uclamp_min` and `uclamp_max` are independent so a policy can raise a floor\nwithout also widening an administrator-provided ceiling.",
      "type": "object",
      "properties": {
        "affinity": {
          "anyOf": [
            {
              "$ref": "#/$defs/CpuSet"
            },
            {
              "type": "null"
            }
          ]
        },
        "nice": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int8",
          "maximum": 127,
          "minimum": -128
        },
        "rt_priority": {
          "description": "Fixed real-time priority used only with `SchedulingClass::Fifo`.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint8",
          "maximum": 50,
          "minimum": 1
        },
        "scheduling_class": {
          "anyOf": [
            {
              "$ref": "#/$defs/SchedulingClass"
            },
            {
              "type": "null"
            }
          ]
        },
        "uclamp_max": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "maximum": 1024,
          "minimum": 0
        },
        "uclamp_min": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "maximum": 1024,
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "TaskProfileConfig": {
      "type": "object",
      "properties": {
        "affinity_group": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "plan": {
          "$ref": "#/$defs/TaskPlan"
        },
        "scenes": {
          "description": "Partial task-plan overrides selected by the current scheduler scene.",
          "type": "object",
          "properties": {
            "background": {
              "$ref": "#/$defs/TaskPlan"
            },
            "boost": {
              "$ref": "#/$defs/TaskPlan"
            },
            "foreground": {
              "$ref": "#/$defs/TaskPlan"
            },
            "idle": {
              "$ref": "#/$defs/TaskPlan"
            },
            "touch": {
              "$ref": "#/$defs/TaskPlan"
            }
          },
          "additionalProperties": false,
          "default": {}
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "plan"
      ]
    },
    "ThermalPolicyConfig": {
      "type": "object",
      "properties": {
        "sample_interval_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "sample_interval_ms"
      ]
    },
    "ThreadRuleConfig": {
      "type": "object",
      "properties": {
        "comm_regex": {
          "description": "Deprecated v2 spelling retained for configuration compatibility.",
          "type": [
            "string",
            "null"
          ]
        },
        "selector": {
          "description": "Typed selector used by new configurations.",
          "anyOf": [
            {
              "$ref": "#/$defs/ThreadSelector"
            },
            {
              "type": "null"
            }
          ]
        },
        "task_profile": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "task_profile"
      ]
    },
    "ThreadSelector": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "leader"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "comm-regex"
            },
            "pattern": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "pattern"
          ]
        }
      ]
    },
    "WorkloadMatcher": {
      "type": "object",
      "properties": {
        "comm_regex": {
          "type": [
            "string",
            "null"
          ]
        },
        "desktop_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "executable": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
