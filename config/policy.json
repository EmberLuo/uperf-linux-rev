  "governor": {
    "rollout": "legacy",
    "active_sample_ms": 20,
    "idle_sample_ms": 80,
    "active_load_threshold": 0.3,
    "idle_load_threshold": 0.15,
    "ema_time_constant_ms": 40,
    "predict_threshold": 0.15,
    "prediction_gain": 1.0,
    "ramp_latency_ms": 100,
    "min_opp_residency_ms": 10
  },
  "load": {
    "enabled": true,
    "sample_interval_ms": 250,
    "ema_time_constant_ms": 500,
    "heavy_enter": 0.6,
    "heavy_exit": 0.2,
    "heavy_dwell_ms": 1000
  },
  "thermal": {
    "sample_interval_ms": 250
  },
  "input": {
    "enabled": true,
    "trigger_duration_ms": 30,
    "gesture_duration_ms": 100,
    "switch_duration_ms": 400,
    "wake_duration_ms": 500,
    "swipe_distance": 0.03,
    "edge_width": 0.03
  },
  "scheduler": {
    "enabled": true,
    "realtime": {
      "enabled": false,
      "max_priority": 20,
      "housekeeping_cpus": []
    },
    "task_profiles": [
      {
        "id": "background",
        "affinity_group": "efficient",
        "plan": {
          "nice": 10,
          "scheduling_class": "batch",
          "uclamp_min": 0,
          "uclamp_max": 384
        }
      },
      {
        "id": "balanced",
        "affinity_group": "balanced",
        "plan": {
          "nice": 0,
          "scheduling_class": "other",
          "uclamp_min": 128,
          "uclamp_max": 768
        }
      },
      {
        "id": "latency",
        "affinity_group": "performance",
        "plan": {
          "nice": -5,
          "scheduling_class": "other",
          "uclamp_min": 512,
          "uclamp_max": 1024
        }
      },
      {
        "id": "foreground",
        "plan": {
          "uclamp_min": 205
        },
        "scenes": {
          "idle": {
            "uclamp_min": 128
          },
          "touch": {
            "uclamp_min": 384
          },
          "boost": {
            "nice": -5,
            "uclamp_min": 512
          }
        }
      }
    ],
    "process_rules": [],
    "cgroup_classes": [
      {
        "id": "foreground",
        "allowed_cpu_group": "all",
        "cpu_weight": 500
      },
      {
        "id": "background",
        "allowed_cpu_group": "balanced",
        "cpu_weight": 100
      }
    ],
    "focus": {
      "enabled": true,
      "task_profile": "foreground",
      "lease_ttl_ms": 15000,
      "debounce_ms": 150,
      "protected": [
        { "comm_regex": "^gnome-shell$" },
        { "comm_regex": "^pipewire" },
        { "comm_regex": "^wireplumber$" },
        { "comm_regex": "^dbus-(broker|daemon)" },
        { "comm_regex": "^systemd" },
        { "comm_regex": "^Xwayland$" },
        { "comm_regex": "^kwin_wayland$" }
      ]
    }
  },
  "session": {
    "display_blanked_profile": "powersave",
    "locked_profile": "powersave"
  }
}
